{
  "name": "alphalisting",
  "version": "4.5.0",
  "author": "Ethan Lin",
  "files": [
    "alphalisting.php",
    "composer.json",
    "readme.txt",
    "build/",
    "css/*.css",
    "functions/",
    "languages/",
    "scripts/alphalisting-widget-admin.js",
    "scripts/blocks/attributes.json",
    "src/",
    "templates/",
    "vendor/",
    "widgets/"
  ],
  "main": "build/index.js",
  "scripts": {
    "build": "wp-scripts build ./scripts/blocks/index.js && grunt",
    "build:release": "npm run build && composer makepot",
    "check-engines": "wp-scripts check-engines",
    "check-licenses": "wp-scripts check-licenses",
    "format:js": "wp-scripts format-js ./scripts",
    "lint:css": "wp-scripts lint-style ./css/editor.css ./css/style.css",
    "lint:js": "wp-scripts lint-js ./scripts",
    "lint:pkg-json": "wp-scripts lint-pkg-json",
    "makepot": "composer makepot",
    "package": "npm run build:release && npm run package:vendor:prod && npm run package:zip && npm run package:vendor:dev",
    "package:vendor:dev": "composer install",
    "package:vendor:prod": "composer install --no-dev --optimize-autoloader",
    "package:zip": "wp-scripts plugin-zip",
    "packages-update": "wp-scripts packages-update",
    "start": "wp-scripts start ./scripts/blocks/index.js"
  },
  "devDependencies": {
    "@wordpress/scripts": "^34.1.0",
    "grunt": "^1.6.3",
    "grunt-cli": "^1.5.0",
    "grunt-sass": "^4.1.0",
    "grunt-wp-i18n": "^1.0.4",
    "grunt-wp-readme-to-markdown": "^2.1.0",
    "sass": "^1.102.0"
  },
  "dependencies": {
    "@wordpress/icons": "^15.4.0",
    "lodash": "^4.18.1",
    "uuid": "^14.0.1"
  }
}
