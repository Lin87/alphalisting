{
  "name": "alphalisting",
  "version": "4.6.2",
  "author": "Ethan Lin",
  "files": [
    "alphalisting.php",
    "composer.json",
    "readme.txt",
    "build/",
    "css/*.css",
    "functions/",
    "languages/",
    "scripts/alphalisting-widget-admin.js",
    "scripts/blocks/attributes.json",
    "src/",
    "templates/",
    "vendor/",
    "widgets/"
  ],
  "main": "build/index.js",
  "scripts": {
    "build": "wp-scripts build ./scripts/blocks/index.js && grunt",
    "lint:css": "wp-scripts lint-style ./css/editor.css ./css/style.css",
    "lint:js": "wp-scripts lint-js ./scripts",
    "lint:pkg-json": "wp-scripts lint-pkg-json",
    "makepot": "composer makepot",
    "packages-update": "wp-scripts packages-update",
    "release": "composer install && npm run build && composer makepot && composer install --no-dev --optimize-autoloader && wp-scripts plugin-zip && composer install && node ./bin/verify-package.mjs"
  },
  "devDependencies": {
    "@wordpress/scripts": "^37.0.0",
    "adm-zip": "^0.6.1",
    "grunt": "^1.6.3",
    "grunt-cli": "^1.5.0",
    "grunt-sass": "^4.1.0",
    "grunt-wp-i18n": "^1.0.4",
    "grunt-wp-readme-to-markdown": "^2.1.0",
    "sass": "^1.106.1"
  },
  "dependencies": {
    "@wordpress/icons": "^19.0.0",
    "lodash": "^4.18.1",
    "uuid": "^14.0.3"
  }
}
