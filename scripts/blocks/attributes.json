{
    "className": {
        "type": "string"
    },
    "columns": {
        "type": "number",
        "default": 3
    },
    "column-width": {
        "type": "string",
        "default": "15em"
    },
    "column-gap": {
        "type": "string",
        "default": "0.6em"
    },
    "get-all-children": {
        "type": "boolean",
        "default": false
    },
    "display": {
        "type": "string",
        "enum": ["posts", "terms"],
        "default": "posts"
    },
    "alphabet": {
        "type": "string",
        "default": ""
    },
    "group-numbers": {
        "type": "boolean",
        "default": false
    },
    "grouping": {
        "type": "number",
        "default": 1
    },
    "group-by": {
        "type": "string",
        "enum": ["", "last-word"],
        "default": ""
    },
    "instance-id": {
        "type": "string"
    },
    "numbers": {
        "type": "string",
        "enum": ["before", "after", "hide"],
        "default": "hide"
    },
    "symbols-first": {
        "type": "boolean",
        "default": false
    },
    "back-to-top": {
        "type": "boolean",
        "default": true
    },
    "post-type": {
        "type": "string",
        "default": "page"
    },
    "exclude-posts": {
        "type": "array",
        "items": {
            "type": "number"
        },
        "default": []
    },
    "parent-post": {
        "type": "number",
        "default": 0
    },
    "taxonomy": {
        "type": "string",
        "default": ""
    },
    "terms": {
        "type": "array",
        "items": {
            "type": "string"
        },
        "default": []
    },
    "exclude-terms": {
        "type": "array",
        "items": {
            "type": "string"
        },
        "default": []
    },
    "parent-term": {
        "type": "string",
        "default": ""
    },
    "hide-empty": {
        "type": "boolean",
        "default": false
    },
    "hide-empty-terms": {
        "type": "boolean",
        "default": false
    }
}
